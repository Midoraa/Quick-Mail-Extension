{
  "manifest_version": 3,
  "name": "Quick Mail: Mini Inbox for Gmail",
  "short_name": "Quick Mail",
  "version": "1.0.0",
  "description": "Monitor unread Gmail count on the toolbar badge, browse folders, star, archive, trash, and quick-reply from Popup or Side Panel.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Quick Mail: Mini Inbox for Gmail",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "identity",
    "alarms",
    "storage",
    "sidePanel",
    "notifications"
  ],
  "host_permissions": [
    "https://gmail.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "838284327482-5pj0ntc86enuiom1d5epk51305rekh6b.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.modify"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}